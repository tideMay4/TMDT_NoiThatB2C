        }

    .product-info {
        display: flex !important;
        align-items: center !important;
        gap: 14px !important;
        min-width: 0 !important;
    }

        .product-info img,
        .admin-product-img,
        .product-thumb {
            width: 58px !important;
            height: 58px !important;
            min-width: 58px !important;
            max-width: 58px !important;
