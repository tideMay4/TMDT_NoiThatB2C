@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using DoAnCK.Areas.Admin.Models

@model IEnumerable<DoAnCK.Areas.Admin.Models.ProductViewModel>

@{
    ViewBag.Title = "Quản lý sản phẩm";



    var products = Model != null ? Model.ToList() : new List<ProductViewModel>();

    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new List<CategoryViewModel>();

    var priceHistories = ViewBag.PriceHistories as List<ProductPriceViewModel> ?? new List<ProductPriceViewModel>();

    var firstProduct = products.FirstOrDefault();

    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<style>
    /* ===== FIX PRODUCT PAGE ONLY ===== */

    .table-box {
        overflow: hidden !important;
    }

    .product-table {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        table-layout: fixed !important;
    }

        .product-table th,
        .product-table td {
            vertical-align: middle !important;
            padding: 16px !important;
            font-size: 13px !important;
            border-bottom: 1px solid #f0e7de !important;
        }

        .product-table thead th {
            background: #faf4ee !important;
            color: #7f7368 !important;
            font-weight: 750 !important;
        }

        .product-table th:nth-child(1),
        .product-table td:nth-child(1) {
            width: 70px !important;
        }

        .product-table th:nth-child(2),
        .product-table td:nth-child(2) {
            width: 290px !important;
        }

        .product-table th:nth-child(3),
        .product-table td:nth-child(3) {
            width: 130px !important;
        }

        .product-table th:nth-child(4),
        .product-table td:nth-child(4) {
            width: 130px !important;
        }

