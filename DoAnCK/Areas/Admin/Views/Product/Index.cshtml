<!-- ===================== PRODUCT SEO + PRICE MANAGEMENT SCRIPT ===================== -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           1. TỰ ĐỘNG ĐIỀN SLUG SEO, META TITLE, META KEYWORD,
              META DESCRIPTION KHI THÊM SẢN PHẨM
        ===================================================== */

        const createTenSP = document.getElementById("createTenSP");
        const createMaDM = document.getElementById("createMaDM");
        const createSlug = document.getElementById("createSlug");
        const createMoTa = document.getElementById("createMoTa");
        const createThuongHieu = document.getElementById("createThuongHieu");
        const createMetaTitle = document.getElementById("createMetaTitle");
        const createMetaKeyword = document.getElementById("createMetaKeyword");
        const createMetaDescription = document.getElementById("createMetaDescription");

        let daSuaSlug = false;
        let daSuaMetaTitle = false;
        let daSuaMetaKeyword = false;
        let daSuaMetaDescription = false;

        function removeVietnameseTones(str) {
            if (!str) {
                return "";
            }

            str = str.toLowerCase();

            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
            str = str.replace(/đ/g, "d");

            return str;
        }

        function taoSlug(text) {
            text = removeVietnameseTones(text);

            text = text.replace(/[^a-z0-9\s-]/g, "");
            text = text.replace(/\s+/g, "-");
            text = text.replace(/-+/g, "-");
            text = text.replace(/^-+|-+$/g, "");

            return text;
        }

        function layTenDanhMuc() {
            if (!createMaDM || createMaDM.selectedIndex < 0) {
                return "";
            }

            const text = createMaDM.options[createMaDM.selectedIndex].text.trim();

            if (text === "Chọn danh mục") {
                return "";
            }

            return text;
        }

        function catChuoi(text, maxLength) {
            if (!text) {
                return "";
            }

            text = text.trim();

            if (text.length <= maxLength) {
                return text;
            }

            return text.substring(0, maxLength - 3) + "...";
        }

        function taoSEOThemSanPham() {
            if (!createTenSP) {
                return;
            }

            const tenSanPham = createTenSP.value.trim();
            const tenDanhMuc = layTenDanhMuc();
            const moTa = createMoTa ? createMoTa.value.trim() : "";
            const thuongHieu = createThuongHieu && createThuongHieu.value.trim()
                ? createThuongHieu.value.trim()
                : "MODERNO";

            if (tenSanPham.length === 0) {
                if (createSlug && !daSuaSlug) createSlug.value = "";
                if (createMetaTitle && !daSuaMetaTitle) createMetaTitle.value = "";
                if (createMetaKeyword && !daSuaMetaKeyword) createMetaKeyword.value = "";
                if (createMetaDescription && !daSuaMetaDescription) createMetaDescription.value = "";
                return;
            }

            if (createSlug && !daSuaSlug) {
                createSlug.value = taoSlug(tenSanPham);
            }

            if (createMetaTitle && !daSuaMetaTitle) {
                if (tenDanhMuc.length > 0) {
                    createMetaTitle.value = catChuoi(tenSanPham + " - " + tenDanhMuc + " hiện đại | " + thuongHieu, 255);
                }
                else {
                    createMetaTitle.value = catChuoi(tenSanPham + " | " + thuongHieu, 255);
                }
            }

            if (createMetaKeyword && !daSuaMetaKeyword) {
                let keywords = [];

                keywords.push(tenSanPham.toLowerCase());

                if (tenDanhMuc.length > 0) {
                    keywords.push(tenDanhMuc.toLowerCase());
                }

                keywords.push("nội thất");
                keywords.push("nội thất hiện đại");
                keywords.push("moderno");

                createMetaKeyword.value = catChuoi(keywords.join(", "), 255);
            }

            if (createMetaDescription && !daSuaMetaDescription) {
                let description = "";

                if (moTa.length > 0) {
                    description = moTa;
                }
                else if (tenDanhMuc.length > 0) {
                    description = "Khám phá " + tenSanPham + " thuộc danh mục " + tenDanhMuc + " tại MODERNO, phù hợp cho không gian sống hiện đại, tiện nghi và sang trọng.";
                }
                else {
                    description = "Khám phá " + tenSanPham + " tại MODERNO, sản phẩm nội thất hiện đại, phù hợp cho không gian sống tiện nghi và sang trọng.";
                }

                createMetaDescription.value = catChuoi(description, 500);
            }
        }

        if (createSlug) {
            createSlug.addEventListener("input", function () {
                daSuaSlug = true;
            });
        }

        if (createMetaTitle) {
            createMetaTitle.addEventListener("input", function () {
                daSuaMetaTitle = true;
            });
        }

        if (createMetaKeyword) {
            createMetaKeyword.addEventListener("input", function () {
                daSuaMetaKeyword = true;
            });
        }

        if (createMetaDescription) {
            createMetaDescription.addEventListener("input", function () {
                daSuaMetaDescription = true;
            });
        }

        if (createTenSP) {
            createTenSP.addEventListener("input", taoSEOThemSanPham);
            createTenSP.addEventListener("blur", taoSEOThemSanPham);
        }

        if (createMaDM) {
            createMaDM.addEventListener("change", taoSEOThemSanPham);
        }

        if (createMoTa) {
            createMoTa.addEventListener("input", function () {
                if (!daSuaMetaDescription) {
                    taoSEOThemSanPham();
                }
            });
        }

        if (createThuongHieu) {
            createThuongHieu.addEventListener("input", function () {
                if (!daSuaMetaTitle) {
                    taoSEOThemSanPham();
                }
            });
        }


        /* =====================================================
           2. SCRIPT QUẢN LÝ GIÁ SẢN PHẨM
        ===================================================== */

        const productSelect = document.getElementById("priceProductSelect");
        const priceProductSearch = document.getElementById("priceProductSearch");
        const updateType = document.getElementById("priceUpdateType");
        const percentInput = document.getElementById("percentInput");
        const giaMoiInput = document.getElementById("giaMoiInput");
        const currentPriceText = document.getElementById("currentPriceText");
        const currentProductText = document.getElementById("currentProductText");
        const newPricePreview = document.getElementById("newPricePreview");

        const btnMinus = document.getElementById("btnMinusPercent");
        const btnPlus = document.getElementById("btnPlusPercent");

        let originalOptions = [];

        if (productSelect) {
            originalOptions = Array.from(productSelect.options).map(function (option) {
                return {
                    value: option.value,
                    text: option.text,
                    price: option.getAttribute("data-price"),
                    name: option.getAttribute("data-name")
                };
            });
        }

        function formatMoney(value) {
            return Number(value).toLocaleString("vi-VN") + "đ";
        }

        function getCurrentOption() {
            if (!productSelect || productSelect.selectedIndex < 0) {
                return null;
            }

            return productSelect.options[productSelect.selectedIndex];
        }

        function getCurrentPrice() {
            const selected = getCurrentOption();

            if (!selected) {
                return 0;
            }

            return Number(selected.getAttribute("data-price")) || 0;
        }

        function getCurrentName() {
            const selected = getCurrentOption();

            if (!selected) {
                return "Chưa có sản phẩm";
            }

            return selected.getAttribute("data-name") || selected.text;
        }

        function calculateNewPrice() {
            const currentPrice = getCurrentPrice();
            const percent = Number(percentInput && percentInput.value) || 0;
            const type = updateType ? updateType.value : "increase";

            let newPrice = currentPrice;

            if (type === "increase") {
                newPrice = currentPrice + (currentPrice * percent / 100);
            }
            else if (type === "decrease" || type === "discount") {
                newPrice = currentPrice - (currentPrice * percent / 100);
            }
            else if (type === "restore") {
                newPrice = currentPrice;
            }

            if (newPrice < 0) {
                newPrice = 0;
            }

            return Math.round(newPrice);
        }

        function updatePreview() {
            const currentPrice = getCurrentPrice();
            const newPrice = calculateNewPrice();

            if (currentPriceText) {
                currentPriceText.innerText = formatMoney(currentPrice);
            }

            if (currentProductText) {
                currentProductText.innerText = getCurrentName();
            }

            if (newPricePreview) {
                newPricePreview.innerText = formatMoney(newPrice);
            }

            if (giaMoiInput) {
                giaMoiInput.value = newPrice;
            }
        }

        function rebuildOptions(keyword) {
            if (!productSelect) {
                return;
            }

            const searchText = keyword.toLowerCase().trim();

            productSelect.innerHTML = "";

            const filteredOptions = originalOptions.filter(function (item) {
                return item.text.toLowerCase().includes(searchText);
            });

            filteredOptions.forEach(function (item) {
                const option = document.createElement("option");

                option.value = item.value;
                option.text = item.text;

                option.setAttribute("data-price", item.price);
                option.setAttribute("data-name", item.name);

                productSelect.appendChild(option);
            });

            if (filteredOptions.length > 0) {
                productSelect.selectedIndex = 0;
                updatePreview();
            }
            else {
                if (currentPriceText) {
                    currentPriceText.innerText = "0đ";
                }

                if (currentProductText) {
                    currentProductText.innerText = "Không tìm thấy sản phẩm";
                }

                if (newPricePreview) {
                    newPricePreview.innerText = "0đ";
                }

                if (giaMoiInput) {
                    giaMoiInput.value = "";
                }
            }
        }

        if (productSelect) {
            productSelect.addEventListener("change", updatePreview);
        }

        if (priceProductSearch) {
            priceProductSearch.addEventListener("input", function () {
                rebuildOptions(priceProductSearch.value);
            });
        }

        if (updateType) {
            updateType.addEventListener("change", updatePreview);
        }

        if (percentInput) {
            percentInput.addEventListener("input", updatePreview);
        }

        if (giaMoiInput) {
            giaMoiInput.addEventListener("input", function () {
                const value = Number(giaMoiInput.value) || 0;

                if (newPricePreview) {
                    newPricePreview.innerText = formatMoney(value);
                }
            });
        }

        if (btnMinus) {
            btnMinus.addEventListener("click", function () {
                let value = Number(percentInput.value) || 0;

                if (value > 0) {
                    value = value - 1;
                }

                percentInput.value = value;

                updatePreview();
            });
        }

        if (btnPlus) {
            btnPlus.addEventListener("click", function () {
                let value = Number(percentInput.value) || 0;

                value = value + 1;

                percentInput.value = value;

                updatePreview();
            });
        }

        updatePreview();
    });
</script>
