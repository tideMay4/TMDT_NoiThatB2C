                        <button type="button"
                                class="btn-outline-admin"
                                data-bs-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                class="btn-admin">

                            <i class="fa-solid fa-trash"></i>
                            Xác nhận xóa

                        </button>

                    </div>
                }

            </div>

        </div>

    </div>
}


