    /* 3 ô: Giá hiện tại - Tỷ lệ - Giá mới */
    .price-page .price-edit-row {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: 20px !important;
        margin-bottom: 26px !important;
    }

    .price-page .price-card-mini {
        min-height: 130px !important;
        padding: 22px !important;
        border-radius: 22px !important;
        background: #faf7f2 !important;
        border: 1px solid #eadfd2 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
    }

        .price-page .price-card-mini.highlight {
            background: #f2e8dc !important;
        }

        .price-page .price-card-mini span {
            display: block !important;
            color: #7f7368 !important;
            font-size: 13px !important;
            font-weight: 700 !important;
            margin-bottom: 8px !important;
        }

        .price-page .price-card-mini h4 {
            margin: 0 0 6px 0 !important;
            color: #2f241c !important;
            font-size: 28px !important;
            font-weight: 850 !important;
            line-height: 1.15 !important;
        }

        .price-page .price-card-mini p {
            margin: 0 !important;
            color: #7f7368 !important;
            font-size: 12px !important;
        }

    .price-page .percent-control {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        margin: 4px 0 8px !important;
    }

        .price-page .percent-control button {
            width: 36px !important;
            height: 36px !important;
            border-radius: 11px !important;
            border: 1px solid #eadfd2 !important;
            background: #fffdfa !important;
            color: #7b5738 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 13px !important;
        }

        .price-page .percent-control input {
            width: 80px !important;
            height: 36px !important;
            border-radius: 11px !important;
            border: 1px solid #eadfd2 !important;
            text-align: center !important;
            background: #fffdfa !important;
        }

        .price-page .percent-control > span {
            margin: 0 !important;
            color: #2f241c !important;
            font-size: 14px !important;
            font-weight: 700 !important;
        }

    /* Form Giá mới - Ngày bắt đầu - Ngày kết thúc - Trạng thái */
    .price-page .row.g-4.mt-1 {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        gap: 18px !important;
        margin: 0 !important;
    }

        .price-page .row.g-4.mt-1 > [class*="col-"] {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .price-page .row.g-4.mt-1 > .col-md-12 {
            grid-column: 1 / -1 !important;
        }

    .price-page textarea.form-control {
        min-height: 92px !important;
        resize: vertical !important;
    }

    .price-page .row.g-4.mt-1 > .col-md-12.d-flex.justify-content-end {
        display: flex !important;
        justify-content: flex-end !important;
        margin-top: 4px !important;
    }

    .price-page .row.g-4.mt-1 .btn-admin {
        min-height: 48px !important;
        padding: 0 24px !important;
        border-radius: 14px !important;
        background: #b08a63 !important;
        color: #fff !important;
        font-weight: 750 !important;
        box-shadow: 0 14px 30px rgba(176, 138, 99, .22) !important;
    }

    /* Lịch sử giá */
    .price-page .price-history-section {
        margin-top: 34px !important;
    }

    .price-page .price-history-title {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: 18px !important;
        margin-bottom: 18px !important;
    }

        .price-page .price-history-title h5 {
            margin: 0 0 6px 0 !important;
            font-size: 22px !important;
            font-weight: 800 !important;
            color: #2f241c !important;
        }

        .price-page .price-history-title p {
            margin: 0 !important;
            color: #7f7368 !important;
            font-size: 14px !important;
        }

    .price-page .price-table {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

        .price-page .price-table thead th {
            background: #faf4ee !important;
            color: #7f7368 !important;
            font-size: 13px !important;
            font-weight: 750 !important;
            padding: 16px !important;
            border-bottom: 1px solid #eadfd2 !important;
        }

        .price-page .price-table tbody td {
            padding: 16px !important;
            font-size: 13px !important;
            vertical-align: middle !important;
            border-bottom: 1px solid #f0e7de !important;
        }

        .price-page .price-table .product-info img {
            width: 58px !important;
            height: 58px !important;
            min-width: 58px !important;
            object-fit: cover !important;
            border-radius: 14px !important;
            border: 1px solid #eadfd2 !important;
        }

    .price-page .old-price {
        color: #7f7368 !important;
        text-decoration: line-through !important;
    }

    .price-page .new-price {
        color: #4f8a56 !important;
    }

    @@media(max-width: 1200px) {
        .price-page .price-filter-row {
            grid-template-columns: 1fr !important;
        }

        .price-page .price-edit-row {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }

        .price-page .row.g-4.mt-1 {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @@media(max-width: 768px) {
        .price-page .price-title,
        .price-page .price-history-title {
            flex-direction: column !important;
            align-items: flex-start !important;
        }

        .price-page .price-edit-row,
        .price-page .row.g-4.mt-1 {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<div class="page-title fade-up">

    <div>
        <h2>Quản lý sản phẩm</h2>
        <p>Quản lý sản phẩm nội thất, giá bán, tồn kho, hình ảnh và thông tin SEO.</p>
    </div>

    <div>
        <button class="btn-admin" data-bs-toggle="modal" data-bs-target="#createProductModal">
            <i class="fa-solid fa-plus"></i>
            Thêm sản phẩm
        </button>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<!-- ===================== PRODUCT SUMMARY ===================== -->

<div class="dashboard fade-up">

    <div class="stat-card">

        <div class="stat-top">

            <div>
                <div class="stat-title">Tổng sản phẩm</div>
                <div class="stat-value">@ViewBag.TotalProducts</div>
                <div class="stat-footer">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    Tổng sản phẩm trong hệ thống
                </div>
            </div>

            <div class="stat-icon bg-green">
                <i class="fa-solid fa-couch"></i>
            </div>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-top">

            <div>
                <div class="stat-title">Đang hiển thị</div>
                <div class="stat-value">@ViewBag.VisibleProducts</div>
                <div class="stat-footer">
                    <i class="fa-solid fa-check"></i>
                    Sẵn sàng bán
                </div>
            </div>

            <div class="stat-icon bg-blue">
                <i class="fa-solid fa-eye"></i>
            </div>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-top">

            <div>
                <div class="stat-title">Sắp hết hàng</div>
                <div class="stat-value">@ViewBag.LowStockProducts</div>
                <div class="stat-footer down">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Cần nhập thêm
                </div>
            </div>

            <div class="stat-icon bg-orange">
                <i class="fa-solid fa-box-open"></i>
            </div>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-top">

            <div>
                <div class="stat-title">Đang ẩn</div>
                <div class="stat-value">@ViewBag.HiddenProducts</div>
                <div class="stat-footer down">
                    <i class="fa-solid fa-eye-slash"></i>
                    Không hiển thị
                </div>
            </div>

            <div class="stat-icon bg-pink">
                <i class="fa-solid fa-ban"></i>
            </div>

        </div>

    </div>

</div>


<!-- ===================== PRODUCT TABLE ===================== -->

<div class="table-box fade-up">

    <div class="card-header">

        <div>
            <div class="card-title">Danh sách sản phẩm</div>
            <small class="text-muted">Tất cả sản phẩm nội thất đang có trong hệ thống</small>
        </div>

        <div class="d-flex gap-2">

            <button type="button" class="btn-outline-admin">
                <i class="fa-solid fa-download"></i>
                Xuất Excel
            </button>

            <button type="button" class="btn-outline-admin">
                <i class="fa-solid fa-filter"></i>
                Bộ lọc
            </button>

        </div>

    </div>


    <div class="filter-bar">

        <div class="filter-left">

            <input type="text"
                   class="form-control"
                   placeholder="Tìm kiếm sản phẩm..."
                   style="width:300px;" />

            <select class="form-select" style="width:180px;">

                <option>Tất cả danh mục</option>

                @foreach (var cate in categories)
                {
                    <option value="@cate.MaDM">@cate.TenDM</option>
                }

            </select>

            <select class="form-select" style="width:180px;">
                <option>Tất cả trạng thái</option>
                <option>Đang hiển thị</option>
                <option>Đang ẩn</option>
                <option>Hết hàng</option>
            </select>

        </div>

        <div class="filter-right">

            <select class="form-select" style="width:170px;">
                <option>Mới nhất</option>
                <option>Giá tăng dần</option>
                <option>Giá giảm dần</option>
                <option>Tồn kho thấp</option>
            </select>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table product-table">

            <thead>

                <tr>
                    <th style="width:70px;">Mã</th>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Slug SEO</th>
                    <th>Nổi bật</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>

            </thead>

            <tbody>

                @if (products.Any())
                {
                    foreach (var item in products)
                    {
                        <tr>

                            <td>
                                #@item.MaSP
                            </td>

                            <td>
                                <div class="product-info">

                                    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                    {
                                        <img src="@Url.Content(item.HinhAnh)" class="admin-product-img" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/Content/images/no-image.png")" class="admin-product-img" />
                                    }

                                    <div>
                                        <h6>@item.TenSP</h6>
                                        <span>Ngày tạo: @item.NgayTao.ToString("dd/MM/yyyy")</span>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <span class="category-pill">
                                    @item.DanhMuc
                                </span>
                            </td>

                            <td>
                                <div class="price-box">

                                    <strong>@item.Gia.ToString("N0")đ</strong>

                                    @if (item.GiaCu.HasValue)
                                    {
                                        <span>@item.GiaCu.Value.ToString("N0")đ</span>
                                    }

                                </div>
                            </td>

                            <td>
                                @if (item.TonKho > 10)
                                {
                                    <span class="stock stock-good">
                                        @item.TonKho còn
                                    </span>
                                }
                                else if (item.TonKho > 0)
                                {
                                    <span class="stock stock-low">
                                        @item.TonKho còn
                                    </span>
                                }
                                else
                                {
                                    <span class="stock stock-out">
                                        Hết hàng
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="slug-text">
                                    /@item.Slug
                                </span>
                            </td>

                            <td>
                                @if (item.NoiBat)
                                {
                                    <span class="badge-warning">
                                        Nổi bật
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-soft">
                                        Thường
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="badge-success">
                                        Đang hiển thị
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-danger">
                                        Đang ẩn
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <button type="button"
                                        class="btn btn-light btn-sm action-btn"
                                        title="Xem chi tiết">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-light btn-sm action-btn"
                                        title="Sửa sản phẩm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editProductModal_@item.MaSP">

                                    <i class="fa-solid fa-pen"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-light btn-sm action-btn text-danger"
                                        title="Xóa sản phẩm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteProductModal_@item.MaSP">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            Chưa có sản phẩm nào.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>


    <nav>

        <ul class="pagination">

            <li class="page-item active">
                <a class="page-link" href="#">1</a>
            </li>

            <li class="page-item">
