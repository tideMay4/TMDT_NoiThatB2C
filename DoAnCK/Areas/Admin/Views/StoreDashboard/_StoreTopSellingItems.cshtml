@model List<DoAnCK.Areas.Admin.Models.StoreTopProductViewModel>

<div class="card-box shadow-sm p-3 rounded-3 background-white w-100">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent border-0 px-0 pb-2">
        <div>
            <div class="card-title fw-bold" style="color: #7A5C43; font-size: 1.05rem;">
                <i class="fa-solid fa-fire text-danger me-1"></i>Sản phẩm bán chạy
            </div>
            <small class="text-muted">Sản phẩm có lượng tiêu thụ tốt nhất của shop</small>
        </div>
        <span class="badge" style="background-color: #7A5C43;">Top sản phẩm</span>
    </div>

    <!-- Ép d-block w-100 và override align-items/justify-content từ CSS bên ngoài -->
    <div class="chart-box w-100 mt-2" style="position: relative; max-height: 320px; overflow-y: auto; display: block !important;">
        @if (Model != null && Model.Any())
        {
            int totalTopSold = Model.Sum(x => x.SoLuongDaBan);

            <div class="d-flex flex-column gap-3 w-100">
                @foreach (var item in Model)
                {
                    double percent = totalTopSold > 0 ? Math.Round((double)item.SoLuongDaBan / totalTopSold * 100, 1) : 0;

                    <div class="sold-item w-100 p-2 rounded" style="background-color: #FAF8F5; border: 1px solid #EBE3DB;">
                        <!-- Dòng 1: Tên SP & Số lượng + % -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold text-truncate me-2" style="color: #332C28; font-size: 13px; max-width: 65%;" title="@item.TenSP">
                                @item.TenSP
                            </span>
                            <span class="fw-bold text-nowrap" style="color: #7A5C43; font-size: 12px;">
                                @item.SoLuongDaBan.ToString("N0") sp <small class="text-muted fw-normal">(@percent%)</small>
                            </span>
                        </div>

                        <!-- Dòng 2: Progress Bar -->
                        <div class="progress mb-1" style="height: 7px; background-color: #EBE3DB; border-radius: 6px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @percent%; background-color: #7A5C43; border-radius: 6px;"
                                 aria-valuenow="@percent"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 title="@item.TenSP: @item.SoLuongDaBan sản phẩm">
                            </div>
                        </div>

                        <!-- Dòng 3: Giá bán & Doanh thu -->
                        <div class="d-flex justify-content-between align-items-center" style="font-size: 11px; color: #786C66;">
                            <span><i class="fa-solid fa-tag me-1" style="color: #7A5C43;"></i>Giá: @item.GiaBan.ToString("N0")đ</span>
                            <span class="fw-semibold text-success"><i class="fa-solid fa-coins me-1"></i>@item.TongDoanhThu.ToString("N0")đ</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center py-4 w-100">
                <p class="text-muted text-center my-auto" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-box-open me-2"></i>Chưa có dữ liệu bán hàng.
                </p>
            </div>
        }
    </div>
</div>