@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* =====================================================
       ADMIN DASHBOARD FIX - CHỈ ÁP DỤNG TRANG /Admin/Dashboard
       Không dùng class .dashboard / .content-grid cũ để tránh bị CSS cũ kéo lệch
    ===================================================== */

    #adminDashboardFixed {
        width: 100%;
        max-width: 100%;
    }

        #adminDashboardFixed .adm-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 30px;
        }

            #adminDashboardFixed .adm-title h2 {
                margin: 0 0 6px;
                font-size: 30px;
                font-weight: 800;
                color: #2f241c;
                line-height: 1.2;
            }

            #adminDashboardFixed .adm-title p {
                margin: 0;
                font-size: 14px;
                color: #7f7368;
            }

        #adminDashboardFixed .adm-add-btn {
            height: 48px;
            padding: 0 22px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: #b08a63;
            color: #fff !important;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 14px 30px rgba(176, 138, 99, .22);
            white-space: nowrap;
        }

            #adminDashboardFixed .adm-add-btn:hover {
                background: #7b5738;
                color: #fff !important;
            }

        /* 4 thẻ thống kê nằm đúng 1 hàng */
        #adminDashboardFixed .adm-stats {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 24px !important;
            width: 100% !important;
            margin-bottom: 30px !important;
            align-items: stretch !important;
        }

        #adminDashboardFixed .adm-stat-cell {
            min-width: 0 !important;
            width: 100% !important;
        }

            #adminDashboardFixed .adm-stat-cell > *,
            #adminDashboardFixed .adm-stat-cell [class*="col-"],
            #adminDashboardFixed .adm-stat-cell .row {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                flex: none !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            #adminDashboardFixed .adm-stat-cell .stat-card {
                width: 100% !important;
                height: 100% !important;
                min-height: 170px !important;
                margin: 0 !important;
            }

        /* Hàng biểu đồ: doanh thu trái, Product Views phải */
        #adminDashboardFixed .adm-two-col {
            display: grid !important;
            grid-template-columns: minmax(0, 1.65fr) minmax(360px, .95fr) !important;
            gap: 26px !important;
            width: 100% !important;
            margin-bottom: 30px !important;
            align-items: stretch !important;
        }

        #adminDashboardFixed .adm-left,
        #adminDashboardFixed .adm-right {
            min-width: 0 !important;
            width: 100% !important;
        }

            #adminDashboardFixed .adm-left > *,
            #adminDashboardFixed .adm-right > * {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
            }

        #adminDashboardFixed .adm-two-col .card-box,
        #adminDashboardFixed .adm-two-col .table-box,
        #adminDashboardFixed .adm-two-col .compare-section {
            width: 100% !important;
            height: 100% !important;
            margin: 0 !important;
        }

        #adminDashboardFixed .adm-two-col .chart-box {
            height: 350px !important;
            min-height: 350px !important;
            width: 100% !important;
        }

        #adminDashboardFixed .adm-two-col canvas {
            width: 100% !important;
            height: 100% !important;
        }

        /* Đơn hàng gần đây full width */
        #adminDashboardFixed .adm-orders {
            width: 100% !important;
            margin-bottom: 30px !important;
        }

            #adminDashboardFixed .adm-orders > * {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
            }

            #adminDashboardFixed .adm-orders .table-box,
            #adminDashboardFixed .adm-orders .card-box {
                width: 100% !important;
                margin: 0 !important;
            }

        #adminDashboardFixed .adm-footer {
            margin-top: 28px;
            padding: 18px 0 8px;
            text-align: center;
            color: #7f7368;
            font-size: 13px;
        }

    @@media (max-width: 1200px) {
        #adminDashboardFixed .adm-stats {
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 18px !important;
        }

        #adminDashboardFixed .adm-two-col {
            grid-template-columns: minmax(0, 1.5fr) minmax(320px, .9fr) !important;
            gap: 22px !important;
        }

        #adminDashboardFixed .adm-stat-cell .stat-card {
            min-height: 158px !important;
            padding: 22px !important;
        }

        #adminDashboardFixed .adm-stat-cell .stat-value {
            font-size: 28px !important;
        }
    }

    @@media (max-width: 980px) {
        #adminDashboardFixed .adm-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        #adminDashboardFixed .adm-two-col {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 768px) {
        #adminDashboardFixed .adm-title {
            flex-direction: column;
            align-items: flex-start;
        }

        #adminDashboardFixed .adm-stats {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<div id="adminDashboardFixed">

    <!-- ===================== PAGE TITLE ===================== -->

    <div class="adm-title fade-up">

        <div>
            <h2>Dashboard</h2>
            <p>Chào mừng quay lại, Admin. Đây là tổng quan hoạt động cửa hàng nội thất hôm nay.</p>
        </div>

        <div>
            <a href="@Url.Action("Create", "Product", new { area = "Admin" })" class="adm-add-btn">
                <i class="fa-solid fa-plus"></i>
                Thêm sản phẩm
            </a>
        </div>

    </div>


    <!-- ===================== STATISTICS ===================== -->

    <div class="adm-stats fade-up">

        <div class="adm-stat-cell">
            @Html.Action("_TotalRevenue", "Dashboard", new { area = "Admin" })
        </div>

        <div class="adm-stat-cell">
            @Html.Action("_TotalOrders", "Dashboard", new { area = "Admin" })
        </div>

        <div class="adm-stat-cell">
            @Html.Action("_TotalActiveStores", "Dashboard", new { area = "Admin" })
        </div>

        <div class="adm-stat-cell">
            @Html.Action("_TotalCustomers", "Dashboard", new { area = "Admin" })
        </div>

    </div>


    <!-- ===================== MAIN CONTENT ===================== -->

    <div class="adm-two-col fade-up">

        <div class="adm-left">
            @Html.Action("_YearlyRevenueChart", "Dashboard", new { area = "Admin" })
        </div>

        <div class="adm-right">
            @Html.Action("_TopProductViews", "Dashboard", new { area = "Admin" })
        </div>

    </div>


    <!-- ===================== ORDER SECTION ===================== -->

    <div class="adm-orders fade-up">

        @Html.Action("_RecentTransactions", "Dashboard", new { area = "Admin" })

    </div>


    <!-- ===================== PRODUCT + ACTIVITY ===================== -->

    <div class="adm-two-col fade-up">

        <div class="adm-left">
            @Html.Action("_StoreSalesShare", "Dashboard", new { area = "Admin" })
        </div>

        <div class="adm-right">
            @Html.Action("_TopSoldItemsCompare", "Dashboard", new { area = "Admin" })
        </div>

    </div>


    <div class="adm-footer">
        © 2026 Furni Admin Dashboard. Website bán nội thất B2C.
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
