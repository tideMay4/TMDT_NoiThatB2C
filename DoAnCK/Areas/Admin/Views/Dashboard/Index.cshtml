@{
    ViewBag.Title = "Dashboard";
}

<!-- ===================== PAGE TITLE ===================== -->

<div class="page-title fade-up">

    <div>
        <h2>Dashboard</h2>
        <p>Chào mừng quay lại, Admin. Đây là tổng quan hoạt động cửa hàng nội thất hôm nay.</p>
    </div>

    <div>
        <a href="/Admin/Product/Create" class="btn-admin">
            <i class="fa-solid fa-plus"></i>
            Thêm sản phẩm
        </a>
    </div>

</div>


<!-- ===================== STATISTICS ===================== -->

<div class="dashboard fade-up">

    <!-- Cột 1 -->
    @Html.Action("_TotalRevenue", "Dashboard")

    <!-- Cột 2 -->
    @Html.Action("_TotalOrders", "Dashboard")

    <!-- Cột 3 -->
    @Html.Action("_TotalActiveStores", "Dashboard")

    <!-- Cột 4 -->
    @Html.Action("_TotalCustomers", "Dashboard")

</div>

<!-- ===================== MAIN CONTENT ===================== -->

<div class="content-grid fade-up">

    <!-- Revenue Chart -->

    @Html.Action("_YearlyRevenueChart", "Dashboard")

    <!-- Top ProductView -->

    @Html.Action("_TopProductViews", "Dashboard")

</div>


<!-- ===================== ORDER SECTION ===================== -->

<div class="table-box fade-up">

    @Html.Action("_RecentTransactions", "Dashboard")

</div>


<!-- ===================== PRODUCT + ACTIVITY ===================== -->

<div class="content-grid mt-4 fade-up">

    <!-- Bên Trái: Biểu đồ cột Thị phần sản phẩm bán ra theo Cửa hàng -->
    @Html.Action("_StoreSalesShare", "Dashboard", new { area = "Admin" })

    <!-- Bên Phải: Top sản phẩm bán chạy (So sánh giữa các Cửa hàng) -->
    @Html.Action("_TopSoldItemsCompare", "Dashboard", new { area = "Admin" })

</div>


<div class="admin-footer">
    © 2026 Furni Admin Dashboard. Website bán nội thất B2C.
</div>


<!-- ===================== CHART SCRIPT ===================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctx = document.getElementById('revenueChart');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
            datasets: [{
                label: 'Doanh thu',
                data: [120, 190, 160, 250, 220, 310, 380],
                borderColor: '#b08a63',
                backgroundColor: 'rgba(176, 138, 99, 0.18)',
                pointBackgroundColor: '#7b5738',
                pointBorderColor: '#7b5738',
                pointRadius: 4,
                pointHoverRadius: 6,
                borderWidth: 3,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: '#efe5da'
                    },
                    ticks: {
                        color: '#7f7368'
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        color: '#7f7368'
                    }
                }
            }
        }
    });

</script>