@model DoAnCK.Areas.Admin.Models.ProductViewsChartViewModel

<div class="card-box">
    <div class="card-header">
        <div>
            <div class="card-title">Product Views</div>
            <small class="text-muted">Thống kê lượt xem sản phẩm sàn</small>
        </div>
        <div class="chart-legend" style="display: flex; gap: 12px; font-size: 12px;">
            <span style="color: #7A5C43; font-weight: 600;"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> Tuần này</span>
            <span style="color: #D99B6A; font-weight: 600;"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> Tuần trước</span>
        </div>
    </div>

    <div class="chart-box" style="position: relative; height: 300px;">
        <canvas id="productViewsChart"></canvas>
    </div>

    <!-- BỔ SUNG: Bảng so sánh lượt xem giữa các shop (Nếu muốn hiển thị) -->
    @if (ViewBag.CompareViews != null)
    {
        var compareList = ViewBag.CompareViews as IEnumerable<dynamic>;
        if (compareList != null && compareList.Any())
        {
            <hr style="margin: 20px 0; border-color: #EBE3DB;" />
            <div class="compare-section">
                <h6 style="font-weight: 600; color: #7A5C43; margin-bottom: 12px; font-size: 0.9rem;">
                    <i class="fa-solid fa-code-compare"></i> So sánh lượt xem các shop cùng bán 1 sản phẩm
                </h6>
                <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                    <table class="table table-sm table-borderless align-middle" style="font-size: 0.85rem;">
                        <thead>
                            <tr style="color: #786C66; border-bottom: 1px solid #EBE3DB;">
                                <th>Sản phẩm</th>
                                <th>Shop dẫn đầu</th>
                                <th class="text-end">Lượt xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in compareList)
                            {
                                var topStore = item.DanhSachCuaHang[0];
                                <tr>
                                    <td><strong>@item.TenSanPham</strong></td>
                                    <td>
                                        <span class="badge" style="background-color: #7A5C43; font-size: 10px;">Top 1</span>
                                        @topStore.TenCuaHang
                                    </td>
                                    <td class="text-end" style="color: #7A5C43; font-weight: 600;">@topStore.LuotXem</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctxView = document.getElementById('productViewsChart');
        if (ctxView) {
            const labelsViews = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Labels));
            const viewsThisWeek = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ViewsThisWeek));
            const viewsLastWeek = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ViewsLastWeek));

            new Chart(ctxView.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labelsViews,
                    datasets: [
                        {
                            label: 'Tuần này',
                            data: viewsThisWeek,
                            backgroundColor: '#7A5C43',
                            borderRadius: 6,
                            barThickness: 8
                        },
                        {
                            label: 'Tuần trước',
                            data: viewsLastWeek,
                            backgroundColor: '#D99B6A',
                            borderRadius: 6,
                            barThickness: 8
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#786C66' }
                        },
                        y: {
                            grid: { borderDash: [4, 4], color: '#EBE3DB' },
                            ticks: { color: '#786C66' }
                        }
                    }
                }
            });
        }
    });
</script>