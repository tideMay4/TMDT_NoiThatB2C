@model DoAnCK.Areas.Admin.Models.ProductViewsChartViewModel
@using DoAnCK.Areas.Admin.Models

<div class="card-box">
    <div class="card-header">
        <div>
            <div class="card-title">Product Views</div>
            <small class="text-muted">Thống kê lượt xem sản phẩm sàn</small>
        </div>
        <div class="chart-legend" style="display: flex; gap: 12px; font-size: 12px;">
            <span style="color: #7A5C43; font-weight: 600;"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> Tuần này</span>
            <span style="color: #D99B6A; font-weight: 600;"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> Tuần trước</span>
        </div>
    </div>

    <div class="chart-box" style="position: relative; height: 300px;">
        <canvas id="productViewsChart"></canvas>
    </div>

    <!-- BẢNG SO SÁNH LƯỢT XEM GIỮA CÁC SHOP CÙNG BÁN SẢN PHẨM -->
    @if (ViewBag.CompareViews != null)
    {
        var compareList = ViewBag.CompareViews as List<ProductCompareViewItem>;

        if (compareList != null && compareList.Any())
        {
            <hr style="margin: 20px 0; border-color: #EBE3DB;" />
            <div class="compare-section">
                <h6 style="font-weight: 600; color: #7A5C43; margin-bottom: 12px; font-size: 0.9rem;">
                    <i class="fa-solid fa-code-compare"></i> So sánh lượt xem các shop cùng bán sản phẩm
                </h6>
                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle" style="font-size: 0.85rem; border-color: #EBE3DB;">
                        <thead>
                            <tr style="color: #786C66; border-bottom: 2px solid #EBE3DB; background-color: #FAF8F5;">
                                <th>Sản phẩm</th>
                                <th style="width: 100px;">Thứ hạng</th>
                                <th>Cửa hàng</th>
                                <th class="text-end" style="width: 120px;">Lượt xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in compareList)
                            {
                                if (item.DanhSachCuaHang != null && item.DanhSachCuaHang.Any())
                                {
                                    int rank = 1;
                                    int totalStores = item.DanhSachCuaHang.Count;

                                    foreach (var store in item.DanhSachCuaHang)
                                    {
                                        <tr>
                                            <!-- Cột Tên sản phẩm: Tự động gom nhóm nếu sản phẩm xuất hiện ở nhiều shop -->
                                            @if (rank == 1)
                                            {
                                                <td rowspan="@totalStores" class="align-middle fw-bold" style="background-color: #FDFBF7; border-right: 1px solid #EBE3DB; color: #524339;">
                                                    @item.TenSanPham
                                                </td>
                                            }

                                            <!-- Cột Thứ hạng lượt xem -->
                                            <td>
                                                @if (rank == 1)
                                                {
                                                    <span class="badge" style="background-color: #7A5C43; font-size: 10px;">Top 1</span>
                                                }
                                                else if (rank == 2)
                                                {
                                                    <span class="badge" style="background-color: #D99B6A; font-size: 10px;">Top 2</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary" style="font-size: 10px;">Top @rank</span>
                                                }
                                            </td>

                                            <!-- Cột Tên cửa hàng -->
                                            <td style="color: #4A403A;">@store.TenCuaHang</td>

                                            <!-- Cột Số lượt xem -->
                                            <td class="text-end fw-bold" style="color: #7A5C43;">
                                                @store.LuotXem.ToString("N0")
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctxView = document.getElementById('productViewsChart');
        if (ctxView) {
            const labelsViews = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Labels));
            const viewsThisWeek = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ViewsThisWeek));
            const viewsLastWeek = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ViewsLastWeek));

            new Chart(ctxView.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labelsViews,
                    datasets: [
                        {
                            label: 'Tuần này',
                            data: viewsThisWeek,
                            backgroundColor: '#7A5C43',
                            borderRadius: 6,
                            barThickness: 8
                        },
                        {
                            label: 'Tuần trước',
                            data: viewsLastWeek,
                            backgroundColor: '#D99B6A',
                            borderRadius: 6,
                            barThickness: 8
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#786C66' }
                        },
                        y: {
                            grid: { borderDash: [4, 4], color: '#EBE3DB' },
                            ticks: { color: '#786C66' }
                        }
                    }
                }
            });
        }
    });
</script>