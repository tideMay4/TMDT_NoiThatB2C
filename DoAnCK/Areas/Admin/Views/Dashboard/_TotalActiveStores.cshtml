﻿@model DoAnCK.Areas.Admin.Models.StoreViewModel

<div class="stat-card">
    <div class="stat-top">
        <div>
            <div class="stat-title">Cửa hàng hoạt động</div>
            <div class="stat-value">@Model.TongSoCuaHang</div>
            <div class="stat-footer">
                <i class="fa-solid fa-arrow-trend-up"></i>
                +@Model.SoCuaHangMoiThangNay shop mới tháng này
            </div>
        </div>

        <div class="stat-icon bg-orange">
            <i class="fa-solid fa-store"></i>
        </div>
    </div>
</div>