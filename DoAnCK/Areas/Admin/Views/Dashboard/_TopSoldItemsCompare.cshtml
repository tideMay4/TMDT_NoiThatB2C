@model List<DoAnCK.Areas.Admin.Models.TopSoldCompareViewModel>

<div class="card-box">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <div class="card-title">Sản phẩm bán chạy</div>
            <small class="text-muted">Top sản phẩm bán ra theo từng cửa hàng</small>
        </div>
        <!-- Chú thích nằm ngang chuẩn không rớt dòng -->
        <div class="chart-legend d-flex align-items-center gap-3" style="font-size: 11px; white-space: nowrap;">
            <span style="color: #7A5C43; font-weight: 600;"><i class="fa-solid fa-circle me-1" style="font-size: 7px;"></i>Shop A</span>
            <span style="color: #D99B6A; font-weight: 600;"><i class="fa-solid fa-circle me-1" style="font-size: 7px;"></i>Shop B</span>
        </div>
    </div>

    <div class="chart-box" style="position: relative; height: 300px; overflow-y: auto;">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="sold-item mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-semibold text-truncate" style="color: #332C28; font-size: 13px; max-width: 75%;" title="@item.TenSanPham">
                            @item.TenSanPham
                        </span>
                        <span class="fw-bold" style="color: #7A5C43; font-size: 13px;">@item.TiLeShopA%</span>
                    </div>

                    <div class="progress" style="height: 8px; background-color: #EBE3DB; border-radius: 6px; display: flex; overflow: hidden;">
                        <div class="progress-bar" title="@item.TenCuaHangA: @item.SoLuongShopA sp"
                             style="width: @item.TiLeShopA%; background-color: #7A5C43; border-radius: 6px;" aria-valuenow="@item.TiLeShopA"></div>
                        @if (item.SoLuongShopB > 0)
                        {
                            <div class="progress-bar" title="@item.TenCuaHangB: @item.SoLuongShopB sp"
                                 style="width: @item.TiLeShopB%; background-color: #D99B6A; border-radius: 6px; margin-left: 2px;" aria-valuenow="@item.TiLeShopB"></div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 11px; color: #786C66;">
                        <span><i class="fa-solid fa-store me-1" style="color: #7A5C43;"></i>@item.TenCuaHangA (@item.SoLuongShopA sp)</span>
                        @if (item.SoLuongShopB > 0)
                        {
                            <span><i class="fa-solid fa-store me-1" style="color: #D99B6A;"></i>@item.TenCuaHangB (@item.SoLuongShopB sp)</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center h-100">
                <p class="text-muted text-center my-auto">Chưa có dữ liệu sản phẩm.</p>
            </div>
        }
    </div>
</div>