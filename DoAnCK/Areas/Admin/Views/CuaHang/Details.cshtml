@model DoAnCK.Models.CUAHANG
@{
    ViewBag.Title = "Chi tiết Cửa Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Inter', sans-serif !important;
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 4px;
    }

    .admin-card {
        background: #fff;
        border-radius: 12px;
        padding: 32px 40px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.03);
        max-width: 800px;
        margin-top: 24px;
        border: 1px solid #f1f3f5;
    }

    .info-label {
        font-size: 13px;
        font-weight: 600;
        color: #8b9096;
        text-transform: uppercase;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 15px;
        color: #212529;
        font-weight: 500;
        background: #f8f9fa;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .btn-brown {
        background-color: #A38262;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 50rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }

        .btn-brown:hover {
            background-color: #8b6b4c;
            color: white;
            transform: translateY(-2px);
        }

    .btn-light-mod {
        background: #fff;
        border: 1px solid #dee2e6;
        color: #495057;
        padding: 10px 24px;
        border-radius: 50rem;
        text-decoration: none;
        font-weight: 500;
        display: inline-block;
        transition: all 0.2s;
    }

        .btn-light-mod:hover {
            background: #f8f9fa;
        }

    .badge-status {
        padding: 6px 14px;
        border-radius: 50rem;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-active {
        background-color: rgba(25, 135, 84, 0.1);
        color: #198754;
    }

    .badge-warning-light {
        background-color: rgba(253, 126, 20, 0.1);
        color: #fd7e14;
    }

    .badge-inactive {
        background-color: rgba(108, 117, 125, 0.1);
        color: #6c757d;
    }
</style>

<div class="container-fluid" style="padding: 20px 30px;">
    <div class="mb-4">
        <h2 class="page-title">Thông tin chi tiết chi nhánh</h2>
        <a href="@Url.Action("Index", "CuaHang")" style="color: #6c757d; text-decoration: none; font-size: 14px;"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách</a>
    </div>

    <div class="admin-card">
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-label">Mã chi nhánh</div>
                <div class="info-value fw-bold" style="color: #A38262;">#@Model.MaCH</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Trạng thái hoạt động</div>
                <div>
                    @if (Model.TrangThai == 1)
                    {<span class="badge-status badge-active">Đang hoạt động</span> }
                    else if (Model.TrangThai == 2)
                    { <span class="badge-status badge-warning-light">Sắp khai trương</span> }
                    else
                    { <span class="badge-status badge-inactive">Tạm đóng cửa</span>}
                </div>
            </div>
            <div class="col-md-6 mt-4">
                <div class="info-label">Tên cơ sở chi nhánh</div>
                <div class="info-value">@Model.TenCH</div>
            </div>
            <div class="col-md-6 mt-4">
                <div class="info-label">Số điện thoại liên hệ</div>
                <div class="info-value">@(string.IsNullOrEmpty(Model.DienThoai) ? "Chưa cập nhật" : Model.DienThoai)</div>
            </div>
            <div class="col-md-12 mt-4">
                <div class="info-label">Địa chỉ đăng ký kinh doanh</div>
                <div class="info-value">@Model.DiaChi</div>
            </div>
        </div>

        <div style="text-align: right; border-top: 1px solid #e9ecef; padding-top: 24px; margin-top: 30px;">
            <a href="@Url.Action("Index", "CuaHang")" class="btn-light-mod me-2">Đóng</a>
            <a href="@Url.Action("Edit", "CuaHang", new { id = Model.MaCH })" class="btn-brown"><i class="fa-solid fa-pen me-1"></i> Chỉnh sửa thông tin</a>
        </div>
    </div>
</div>