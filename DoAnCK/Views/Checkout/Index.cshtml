@model DoAnCK.Models.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --brand-dark: #2B2623;
        --brand-bg: #F8F7F5;
        --text-main: #333333;
        --text-muted: #888888;
        --border-soft: #EAE8E3;
        --danger-color: #D9534F;
    }

    body {
        background-color: var(--brand-bg) !important;
    }

    .checkout-wrapper {
        font-family: 'Montserrat', 'Segoe UI', Tahoma, sans-serif;
        padding: 40px 0;
    }

    .checkout-container {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
        color: var(--text-main);
    }

    .checkout-details,
    .order-summary {
        flex: 1;
        min-width: 320px;
        background: #FFFFFF;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        border: 1px solid rgba(0,0,0,0.02);
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 25px;
        color: var(--brand-dark);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 15px;
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        box-sizing: border-box;
        background-color: #FAFAFA;
        transition: all 0.3s ease;
        font-family: inherit;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--brand-dark);
            background-color: #FFF;
        }

    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .payment-method {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        cursor: pointer;
        background: #FAFAFA;
        font-weight: 500;
    }

    .cart-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid var(--border-soft);
        gap: 15px;
    }

    .item-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
    }

    .item-name {
        font-weight: 600;
        color: var(--brand-dark);
    }

    .item-qty {
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .item-price {
        font-weight: 600;
        white-space: nowrap;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        color: var(--text-muted);
        font-weight: 500;
    }

    .highlight-bulky {
        color: var(--danger-color);
        font-size: 0.85rem;
        font-weight: normal;
    }

    .total-line {
        border-top: 2px solid var(--border-soft);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--brand-dark);
        margin-top: 15px;
        padding-top: 20px;
    }

    .btn-submit-order {
        width: 100%;
        padding: 16px;
        background-color: var(--brand-dark);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        margin-top: 30px;
        transition: 0.3s;
    }

        .btn-submit-order:hover {
            background-color: #000000;
        }
</style>

<div class="checkout-wrapper">

    <div class="checkout-container">

        <div class="checkout-details">

            <h3 class="section-title">Thông tin giao hàng</h3>

            <form id="checkoutForm">

                <div class="form-group">
                    <input type="text" class="form-control" name="FullName" placeholder="Họ và tên" required />
                </div>

                <div class="form-group">
                    <input type="tel" class="form-control" name="PhoneNumber" placeholder="Số điện thoại" required />
                </div>

                <label style="font-weight: 600; margin-top: 15px; margin-bottom: 5px; display: block;">
                    Địa chỉ giao hàng:
                </label>

                <div class="row" style="margin-bottom: 15px; display: flex; gap: 15px;">
                    <div class="col" style="flex: 1;">
                        <select class="form-control" id="city" name="City" required>
                            <option value="" selected disabled>Chọn Tỉnh / Thành phố</option>
                        </select>
                    </div>

                    <div class="col" style="flex: 1;">
                        <select class="form-control" id="district" name="District" required>
                            <option value="" selected disabled>Chọn Quận / Huyện</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <select class="form-control" id="ward" name="Ward" required>
                        <option value="" selected disabled>Chọn Phường / Xã</option>
                    </select>
                </div>

                <div class="form-group">
                    <input type="text" class="form-control" id="street" name="Street" placeholder="Số nhà, tên đường..." required />
                    <input type="hidden" id="txtCityName" name="CityName" value="" />
                </div>

                <h3 class="section-title mt-4" style="margin-top: 30px;">Phương thức thanh toán</h3>

                <div class="payment-options">
                    <label class="payment-method">
                        <input type="radio" name="PaymentType" value="COD" checked />
                        <span>Thanh toán khi nhận hàng</span>
                    </label>

                    <label class="payment-method">
                        <input type="radio" name="PaymentType" value="QR_BANK" />
                        <span>Chuyển khoản qua mã QR ngân hàng</span>
                    </label>

                    
                </div>

                <button type="button" class="btn-submit-order" id="btnPlaceOrder">
                    ĐẶT HÀNG
                </button>

            </form>

        </div>

        <div class="order-summary">

            <h3 class="section-title">Đơn hàng của bạn</h3>

            <div class="cart-items">

                @if (Model != null && Model.CartItems != null && Model.CartItems.Count > 0)
                {
                    foreach (var item in Model.CartItems)
                    {
                        var isBulkyStr = item.IsBulky.ToString().ToLower();
                        var lineTotal = item.Price * item.Quantity;

                <div class="cart-item" data-is-bulky="@isBulkyStr">

                    <div class="item-info">
                        <span class="item-name">
                            @item.ProductName

                            @if (item.IsBulky)
                                    {
                            <span class="highlight-bulky">(Cồng kềnh)</span>
                                    }
                        </span>

                        <span class="item-qty">
                            Số lượng: @item.Quantity
                        </span>
                    </div>

                    <span class="item-price" data-price="@lineTotal">
                        @lineTotal.ToString("N0") ₫
                    </span>

                </div>
                    }
                }
                else
                {
                <p style="color: var(--text-muted); font-style: italic;">
                    Giỏ hàng của bạn đang trống.
                </p>
                }

            </div>

            <div style="margin-top: 20px;">

                <div class="summary-line">
                    <span>Tạm tính</span>
                    <span id="subTotal" style="color: var(--text-main);">0 ₫</span>
                </div>

                <div class="summary-line">
                    <span>Phí vận chuyển</span>
                    <span id="shippingFee" style="color: var(--text-main);">0 ₫</span>
                </div>

                <div class="summary-line">
                    <span class="highlight-bulky">Phí phụ thu hàng cồng kềnh</span>
                    <span id="bulkyFee" class="highlight-bulky">0 ₫</span>
                </div>

                <div class="summary-line total-line">
                    <span>Tổng cộng</span>
                    <span id="totalPrice">0 ₫</span>
                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        const SHIPPING_FEE = @(Model != null ? Model.ShippingFee : 0);
        const BULKY_ITEM_FEE = @(Model != null ? Model.BulkyFeePerItem : 0);

        function calculateTotal() {
            let subTotal = 0;
            let hasBulkyItem = false;

            $('.cart-item').each(function () {
                let price = parseFloat($(this).find('.item-price').attr('data-price')) || 0;
                subTotal += price;

                if ($(this).attr('data-is-bulky') === "true") {
                    hasBulkyItem = true;
                }
            });

            let currentBulkyFee = hasBulkyItem ? BULKY_ITEM_FEE : 0;
            let total = subTotal + SHIPPING_FEE + currentBulkyFee;

            $('#subTotal').text(subTotal.toLocaleString('vi-VN') + ' ₫');
            $('#shippingFee').text(SHIPPING_FEE.toLocaleString('vi-VN') + ' ₫');
            $('#bulkyFee').text(currentBulkyFee.toLocaleString('vi-VN') + ' ₫');
            $('#totalPrice').text(total.toLocaleString('vi-VN') + ' ₫');
        }

        calculateTotal();

        $('#btnPlaceOrder').click(function () {
            let rawTotal = $('#totalPrice').text().replace(/\./g, '').replace(' ₫', '').trim();

            let address =
                $('#street').val() + ', ' +
                $('#ward option:selected').text() + ', ' +
                $('#district option:selected').text() + ', ' +
                $('#city option:selected').text();

            let formData = {
                FullName: $('input[name="FullName"]').val(),
                PhoneNumber: $('input[name="PhoneNumber"]').val(),
                Address: address,
                PaymentMethod: $('input[name="PaymentType"]:checked').val(),
                TotalPrice: parseInt(rawTotal)
            };

            if (!formData.FullName || !formData.PhoneNumber || !$('#street').val()) {
                alert("Vui lòng nhập đầy đủ thông tin giao hàng.");
                return;
            }

            $(this).text('Đang xử lý...').prop('disabled', true);

            if (formData.PaymentMethod === 'COD') {
                $.ajax({
                    url: '/Checkout/ProcessCOD',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success) {
                            window.location.href = '/Checkout/OrderSuccess?orderCode=' + res.orderCode;
                        } else {
                            alert(res.message || "Đã xảy ra lỗi khi đặt hàng.");
                            $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                        }
                    },
                    error: function () {
                        alert("Không kết nối được đến server.");
                        $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                    }
                });
            } else if (formData.PaymentMethod === 'QR_BANK') {
                $.ajax({
                    url: '/Checkout/PaymentWithPayOS',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success && res.url) {
                            window.location.href = res.url;
                        } else {
                            alert(res.message || "Chức năng thanh toán QR ngân hàng chưa sẵn sàng.");
                            $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                        }
                    },
                    error: function () {
                        alert("Không kết nối được thanh toán QR ngân hàng.");
                        $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                    }
                });
            } else if (formData.PaymentMethod === 'QR_MOMO') {
                $.ajax({
                    url: '/Checkout/PaymentWithMoMo',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success && res.url) {
                            window.location.href = res.url;
                        } else {
                            alert(res.message || "Chức năng MoMo chưa sẵn sàng.");
                            $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                        }
                    },
                    error: function () {
                        alert("Không kết nối được thanh toán MoMo.");
                        $('#btnPlaceOrder').text('ĐẶT HÀNG').prop('disabled', false);
                    }
                });
            }
        });

        $.ajax({
            url: "https://provinces.open-api.vn/api/?depth=3",
            method: "GET",
            success: function (data) {
                let cityHtml = '<option value="" selected disabled>Chọn Tỉnh / Thành phố</option>';

                $.each(data, function (index, city) {
                    cityHtml += `<option value="${city.code}" data-name="${city.name}">${city.name}</option>`;
                });

                $("#city").html(cityHtml);

                $("#city").change(function () {
                    let cityCode = $(this).val();
                    let cityName = $(this).find(':selected').data('name');

                    $("#txtCityName").val(cityName);

                    $.post('/Checkout/CalculatePriceByLocation', { cityName: cityName }, function (res) {
                        if (res.success) {
                            $('#shippingFee').text(res.shippingFee.toLocaleString('vi-VN') + ' ₫');
                            $('#totalPrice').text(res.totalPrice.toLocaleString('vi-VN') + ' ₫');
                        }
                    });

                    let selectedCity = data.find(c => c.code == cityCode);
                    let districtHtml = '<option value="" selected disabled>Chọn Quận / Huyện</option>';

                    if (selectedCity && selectedCity.districts) {
                        $.each(selectedCity.districts, function (index, district) {
                            districtHtml += `<option value="${district.code}">${district.name}</option>`;
                        });
                    }

                    $("#district").html(districtHtml);
                    $("#ward").html('<option value="" selected disabled>Chọn Phường / Xã</option>');
                });

                $("#district").change(function () {
                    let cityCode = $("#city").val();
                    let districtCode = $(this).val();
                    let selectedCity = data.find(c => c.code == cityCode);
                    let selectedDistrict = selectedCity.districts.find(d => d.code == districtCode);

                    let wardHtml = '<option value="" selected disabled>Chọn Phường / Xã</option>';

                    if (selectedDistrict && selectedDistrict.wards) {
                        $.each(selectedDistrict.wards, function (index, ward) {
                            wardHtml += `<option value="${ward.code}">${ward.name}</option>`;
                        });
                    }

                    $("#ward").html(wardHtml);
                });
            }
        });
    });
</script>