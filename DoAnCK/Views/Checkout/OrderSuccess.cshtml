@model DoAnCK.Models.DONHANG
@{
    ViewBag.Title = "Hóa đơn thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width: 850px; margin: 40px auto; padding: 20px;">
    <div class="no-print" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <a href="@Url.Action("Index", "Home")" class="btn" style="background: #fff; color: #000; border: 2px solid #000; padding: 12px 25px; border-radius: 4px; text-decoration: none; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
            <i class="fa-solid fa-arrow-left"></i> Tiếp tục mua sắm
        </a>
        <button onclick="window.print();" class="btn" style="background: #000; color: #fff; border: 2px solid #000; padding: 12px 25px; border-radius: 4px; cursor: pointer; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
            <i class="fa-solid fa-print"></i> In hóa đơn
        </button>
    </div>

    @if (Model != null)
    {
        <div id="invoice-card" style="background: #fff; padding: 40px; border-radius: 8px; border: 1px solid #EAE8E3; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">

            <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 20px; margin-bottom: 30px;">
                <div>
                    <h2 style="font-weight: 900; text-transform: uppercase; margin: 0; color: #000;">MODERNO</h2>
                    <p style="margin: 5px 0 0 0; color: #555; font-size: 0.9em;">123 Nguyễn Du, Quận 1, TP. Hồ Chí Minh</p>
                    <p style="margin: 2px 0 0 0; color: #555; font-size: 0.9em;">Hotline: 1900 xxxx</p>
                </div>
                <div style="text-align: right;">
                    <h3 style="margin: 0; color: #000; font-weight: bold; text-transform: uppercase;">HÓA ĐƠN</h3>
                    <p style="margin: 5px 0 0 0; font-weight: 600; color: #000;">Mã HD: #@Model.MaDH</p>
                    <p style="margin: 2px 0 0 0; color: #666; font-size: 0.9em;">Ngày lập: @(Model.NgayDat != null ? Convert.ToDateTime(Model.NgayDat).ToString("dd/MM/yyyy HH:mm") : DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>
                </div>
            </div>

            <div style="display: flex; gap: 40px; margin-bottom: 35px;">
                <div style="flex: 1;">
                    <h5 style="border-bottom: 1px solid #DDD; padding-bottom: 5px; margin-bottom: 10px; font-weight: bold; color: #000; text-transform: uppercase; font-size: 0.95em;">Thông tin khách hàng</h5>
                    <p style="margin: 5px 0; color: #000;"><strong>Người nhận:</strong> @(Model.KHACHHANG != null ? Model.KHACHHANG.HoTen : "Khách hàng")</p>
                    <p style="margin: 5px 0; color: #000;"><strong>Điện thoại:</strong> @(Model.KHACHHANG != null ? Model.KHACHHANG.SDT : "")</p>
                    <p style="margin: 5px 0; line-height: 1.4; color: #000;"><strong>Địa chỉ:</strong> @(Model.KHACHHANG != null ? Model.KHACHHANG.DiaChi : "")</p>
                </div>
                <div style="flex: 1;">
                    <h5 style="border-bottom: 1px solid #DDD; padding-bottom: 5px; margin-bottom: 10px; font-weight: bold; color: #000; text-transform: uppercase; font-size: 0.95em;">Thanh toán & Trạng thái</h5>
                    <p style="margin: 5px 0; color: #000;">
                        <strong>Hình thức:</strong>
                        <span style="background: #F4F4F4; padding: 4px 10px; border-radius: 4px; font-weight: 600; color: #000; font-size: 0.9em; display: inline-block; margin-left: 5px; border: 1px solid #DDD;">
                            Thanh toán trực tuyến / Tiền mặt
                        </span>
                    </p>
                    <p style="margin: 8px 0; color: #000;">
                        <strong>Trạng thái:</strong>
                        <span style="color: #000; font-weight: bold; margin-left: 5px;"> Đã hoàn tất</span>
                    </p>
                </div>
            </div>

            <h5 style="font-weight: bold; color: #000; margin-bottom: 10px; text-transform: uppercase; font-size: 0.95em;">Chi tiết đơn hàng</h5>
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                <thead>
                    <tr style="background: #F9F9F9; border-bottom: 2px solid #000; border-top: 1px solid #000;">
                        <th style="padding: 15px 12px; text-align: left; font-weight: bold; color: #000;">Sản phẩm</th>
                        <th style="padding: 15px 12px; text-align: center; font-weight: bold; width: 100px; color: #000;">SL</th>
                        <th style="padding: 15px 12px; text-align: right; font-weight: bold; width: 150px; color: #000;">Đơn giá</th>
                        <th style="padding: 15px 12px; text-align: right; font-weight: bold; width: 180px; color: #000;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CHITIET_DONHANG != null)
                    {
                        foreach (var detail in Model.CHITIET_DONHANG)
                        {
                            decimal donGia = Convert.ToDecimal(detail.GiaBan);
                            int soLuong = Convert.ToInt32(detail.SoLuong);
                            decimal thanhTienChiTiet = donGia * soLuong;

                            <tr style="border-bottom: 1px solid #EAE8E3;">
                                <td style="padding: 15px 12px; text-align: left;">
                                    <span style="font-weight: 600; color: #000;">@detail.SANPHAM.TenSP</span>
                                </td>
                                <td style="padding: 15px 12px; text-align: center; color: #333;">@soLuong</td>
                                <td style="padding: 15px 12px; text-align: right; color: #333;">@donGia.ToString("N0") ₫</td>
                                <td style="padding: 15px 12px; text-align: right; font-weight: bold; color: #000;">@thanhTienChiTiet.ToString("N0") ₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div style="display: flex; justify-content: flex-end;">
                @{
                    decimal tongTien = Convert.ToDecimal(Model.TongTien);
                    decimal phiShip = 0;
                    decimal tienHang = tongTien - phiShip;
                }
                <div style="width: 320px; line-height: 2;">
                    <div style="display: flex; justify-content: space-between; color: #333;">
                        <span>Tiền hàng:</span>
                        <span style="font-weight: 600; color: #000;">@tienHang.ToString("N0") ₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: #333;">
                        <span>Phí vận chuyển:</span>
                        <span style="color: #000;">+ 0 ₫</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-top: 2px solid #000; padding-top: 15px; margin-top: 10px;">
                        <span style="font-weight: bold; color: #000; font-size: 1.1em; text-transform: uppercase;">Tổng cộng:</span>
                        <span style="font-weight: 900; color: #000; font-size: 1.3em;">@tongTien.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>

            <div style="text-align: center; margin-top: 60px; border-top: 1px dashed #CCC; padding-top: 25px; color: #555; font-style: italic;">
                <p style="margin-bottom: 5px;">Cảm ơn quý khách đã tin tưởng và lựa chọn sản phẩm của MODERNO!</p>
                <p style="font-size: 0.85em; margin: 0;">(Hóa đơn điện tử được phát hành tự động)</p>
            </div>

        </div>
    }
    else
    {
        <div class="alert text-center" style="background: #fff; border: 2px solid #000; color: #000; padding: 25px; border-radius: 4px; font-weight: bold; text-transform: uppercase;">
            <i class="fa-solid fa-circle-exclamation" style="margin-right: 5px;"></i> @ViewBag.Message
        </div>
    }
</div>

<style>
    /* Bỏ hover của các nút khi in để không bị lỗi màu */
    .no-print .btn:hover {
        background: #333 !important;
        color: #fff !important;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: #fff;
            padding: 0;
            color: #000;
        }

        #invoice-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>