@using System.Linq
@model IEnumerable<DoAnCK.Models.ViewModel.CustomerReviewViewModel>

@{
    ViewBag.Title = "Đánh giá của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .review-page {
        max-width: 1050px;
        margin: 50px auto;
        padding: 0 16px;
    }

    .review-card {
        background: #fffdfa;
        border: 1px solid #eadfd2;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 14px 35px rgba(92, 65, 42, 0.08);
    }

        .review-card h2 {
            margin: 0 0 8px;
            color: #2f241c;
            font-weight: 800;
        }

        .review-card p {
            color: #7f7368;
            margin-bottom: 24px;
        }

    .review-item {
        display: flex;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid #f0e7de;
    }

        .review-item:last-child {
            border-bottom: none;
        }

    .review-img {
        width: 78px;
        height: 78px;
        border-radius: 14px;
        object-fit: cover;
        border: 1px solid #eadfd2;
    }

    .review-content h4 {
        margin: 0 0 6px;
        color: #2f241c;
        font-size: 16px;
        font-weight: 800;
    }

    .review-stars {
        color: #c49a5a;
        margin-bottom: 8px;
    }

    .review-date {
        color: #7f7368;
        font-size: 13px;
        margin-top: 8px;
    }
</style>

<div class="review-page">

    <div class="review-card">

        <h2>Đánh giá của tôi</h2>
        <p>Danh sách các đánh giá bạn đã gửi cho sản phẩm.</p>

        @if (Model == null || !Model.Any())
        {
            <div style="text-align:center; padding:30px; color:#7f7368;">
                Bạn chưa có đánh giá nào.
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="review-item">

                    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                    {
                        <img src="@Url.Content(item.HinhAnh)" class="review-img" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/Content/images/no-image.png")" class="review-img" />
                    }

                    <div class="review-content">

                        <h4>@item.TenSP</h4>

                        <div class="review-stars">
                            @{
                                int sao = item.SoSao ?? 0;
                            }

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= sao)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }
                        </div>

                        <div>
                            @item.NoiDung
                        </div>

                        <div class="review-date">
                            @(item.NgayDanhGia.HasValue ? item.NgayDanhGia.Value.ToString("dd/MM/yyyy HH:mm") : "")
                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>