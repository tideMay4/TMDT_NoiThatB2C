@model DoAnCK.Models.ViewModel.LoginViewModel
@{
    Layout = null; // Giao diện đăng nhập độc lập
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - Login</title>

    <!-- Font Poppins & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link href="~/Content/css/login-style.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <div class="glass-card">
            <h2>Welcome</h2>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary-errors">
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <div class="input-group">
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email", @type = "email", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.PasswordFor(m => m.Password, new { @placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-login">LOGIN</button>

                <div class="form-links">
                    <a href="@Url.Action("ForgotPassword", "Account")">Forgot Password ?</a>
                    <a href="@Url.Action("Register", "Account")">Sign Up</a>
                </div>

                <div class="divider">
                    <span>OR LOGIN WITH</span>
                </div>

                <div class="social-login">
                    <a href="#" class="social-btn google" title="Login with Google">
                        <i class="fa-brands fa-google"></i>
                    </a>
                    <a href="#" class="social-btn facebook" title="Login with Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</body>
</html>