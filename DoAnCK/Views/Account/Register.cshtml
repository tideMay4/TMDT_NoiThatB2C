﻿@model DoAnCK.Models.ViewModel.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up - Customer</title>

    <!-- Font Poppins & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Dùng chung file CSS với Login -->
    <link href="@Url.Content("~/Content/css/login-style.css")" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <div class="glass-card register-card">
            <h2>Create Account</h2>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "login-form" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary-errors">
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <div class="input-group">
                    @Html.TextBoxFor(m => m.HoTen, new { @placeholder = "Full Name", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email Address", @type = "email", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.TextBoxFor(m => m.SDT, new { @placeholder = "Phone Number", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.SDT, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.TextBoxFor(m => m.DiaChi, new { @placeholder = "Address", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.PasswordFor(m => m.MatKhau, new { @placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                </div>

                <div class="input-group">
                    @Html.PasswordFor(m => m.XacNhanMatKhau, new { @placeholder = "Confirm Password" })
                    @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-login">SIGN UP</button>

                <div class="form-links" style="justify-content: center; margin-top: 10px;">
                    <span>Already have an account?&nbsp;</span>
                    <a href="@Url.Action("Login", "Account")" style="font-weight: 600;">Login here</a>
                </div>
            }
        </div>
    </div>
</body>
</html>