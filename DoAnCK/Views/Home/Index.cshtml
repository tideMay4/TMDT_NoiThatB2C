@using System.Linq
@using DoAnCK.Models.ViewModel
@model IEnumerable<DoAnCK.Models.SANPHAM>

@{
    ViewBag.Title = "Trang chủ";
    var combos = ViewBag.ComboSuggestions as List<ComboSuggestionViewModel>;
}

<section class="hero">

    <div class="banner">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-5">

                    <span class="sub-title">
                        Modern Designs, Timeless Comfort.
                    </span>

                    <h1>
                        Furniture
                        That Defines
                        Your Space
                    </h1>

                    <p>
                        Discover our carefully selected furniture that blends
                        elegance, comfort and functionality for every room.
                    </p>

                    <a href="@Url.Action("Index", "Product")" class="btn-shop">
                        SHOP NOW
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                </div>

                <div class="col-lg-7">

                    <div class="banner-image">
                        <img src="@Url.Content("~/Content/images/banner.jpg")"
                             class="img-fluid"
                             alt="Banner" />
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!--=========================
    SERVICES
==========================-->

<section class="services">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3">
                <i class="fa-solid fa-truck-fast"></i>
                <h6>Free Shipping</h6>
                <p>On orders over $50</p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-shield-halved"></i>
                <h6>Secure Payment</h6>
                <p>100% Secure Checkout</p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-medal"></i>
                <h6>Premium Quality</h6>
                <p>Crafted with care</p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-headset"></i>
                <h6>24/7 Support</h6>
                <p>We're here to help</p>
            </div>

        </div>

    </div>

</section>

<!--=========================
    CATEGORY
==========================-->

<section class="category">

    <div class="container">

        <h3 class="section-title">
            SHOP BY CATEGORY
        </h3>

        <div class="row g-4">

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/sopha.jpg")" alt="Sofa" />
                    <h6>Sofa</h6>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/table.jpg")" alt="Table" />
                    <h6>Table</h6>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/armchair.jpg")" alt="Armchair" />
                    <h6>Armchair</h6>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/bed.jpg")" alt="Bed" />
                    <h6>Bed</h6>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/mirror.jpg")" alt="Mirror" />
                    <h6>Mirror</h6>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="cat-card">
                    <img src="@Url.Content("~/Content/images/lighting.jpg")" alt="Lighting" />
                    <h6>Lighting</h6>
                </div>
            </div>

        </div>

    </div>

</section>

<!--=========================
    SALE BANNER
==========================-->

<section class="sale-section">

    <div class="container">

        <a href="@Url.Action("Index", "Product")" class="sale-banner">
            <img src="@Url.Content("~/Content/images/sale2.jpg")"
                 alt="Summer Sale" />
        </a>

    </div>

</section>

<!--=========================
    NEW ARRIVALS
==========================-->

<section class="home-arrivals">

    <h3 class="section-title">NEW ARRIVALS</h3>

    <div class="home-arrival-grid">

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model.Take(8))
            {
                var hinhAnh = string.IsNullOrWhiteSpace(item.HinhAnh)
                    ? "~/Content/images/no-image.jpg"
                    : item.HinhAnh;

                <div class="home-arrival-card">

                    <div class="home-arrival-img-wrapper">
                        <img src="@Url.Content(hinhAnh)"
                             alt="@item.TenSP"
                             class="product-img" />
                    </div>

                    <div class="home-arrival-info">

                        <h5 class="product-name" title="@item.TenSP">
                            @item.TenSP
                        </h5>

                        <p class="product-price">
                            @String.Format("{0:N0} ₫", item.GiaHienTai)
                        </p>

                        <button type="button"
                                class="btn-add-cart"
                                data-id="@item.MaSP"
                                data-name="@item.TenSP"
                                data-price="@item.GiaHienTai"
                                data-bulky="false"
                                data-image="@Url.Content(hinhAnh)">
                            <i class="fa-solid fa-cart-plus"></i>
                            Thêm vào giỏ
                        </button>

                    </div>

                </div>
            }
        }
        else
        {
            <p>Chưa có sản phẩm nào.</p>
        }

    </div>

</section>

<!--=========================
    COMBO
==========================-->

@if (combos != null && combos.Count > 0)
{
    <section class="combo-section">

        <div class="combo-title">
            <span>MODERNO COMBO</span>
            <h2>Combo nội thất ưu đãi</h2>
            <p>
                Kết hợp các sản phẩm hài hòa cho không gian sống của bạn với mức giá tốt hơn.
            </p>
        </div>

        <div class="combo-grid">

            @foreach (var combo in combos)
            {
                <div class="combo-card">

                    <div class="combo-badge">
                        Giảm @combo.DiscountPercent.ToString("0")%
                    </div>

                    <h3>@combo.ComboName</h3>

                    <div class="combo-products">

                        <div class="combo-product">

                            <img src="@Url.Content(string.IsNullOrWhiteSpace(combo.Product1Image) ? "~/Content/images/no-image.jpg" : combo.Product1Image)"
                                 alt="@combo.Product1Name" />

                            <strong>@combo.Product1Name</strong>

                            <span>
                                Tồn: @combo.Product1Stock
                            </span>

                        </div>

                        <div class="combo-plus">
                            +
                        </div>

                        <div class="combo-product">

                            <img src="@Url.Content(string.IsNullOrWhiteSpace(combo.Product2Image) ? "~/Content/images/no-image.jpg" : combo.Product2Image)"
                                 alt="@combo.Product2Name" />

                            <strong>@combo.Product2Name</strong>

                            <span>
                                Tồn: @combo.Product2Stock
                            </span>

                        </div>

                    </div>

                    <div class="combo-price">
                        <del>@combo.TotalPrice.ToString("N0") ₫</del>
                        <strong>@combo.FinalPrice.ToString("N0") ₫</strong>
                    </div>

                    <button type="button"
                            class="btn-add-combo"
                            data-product1="@combo.Product1Id"
                            data-product2="@combo.Product2Id">
                        Thêm combo vào giỏ
                    </button>

                </div>
            }

        </div>

    </section>
}
else
{
    <section class="combo-section">

        <div class="combo-title">
            <span>MODERNO COMBO</span>
            <h2>Chưa có combo ưu đãi phù hợp</h2>
            <p>
                Các combo nội thất mới sẽ được cập nhật trong thời gian tới.
            </p>
        </div>

    </section>
}

<style>
    .home-arrivals {
        max-width: 1200px;
        margin: 80px auto;
        padding: 0 20px;
        text-align: center;
    }

        .home-arrivals h3.section-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 40px;
            color: #2B2623;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .home-arrival-grid {
        display: flex;
        justify-content: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .home-arrival-card {
        width: 260px;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.04);
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .home-arrival-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

    .home-arrival-img-wrapper {
        width: 100%;
        height: 240px;
        overflow: hidden;
        background-color: #f9f9f9;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .home-arrival-card:hover .product-img {
        transform: scale(1.08);
    }

    .home-arrival-info {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        text-align: center;
    }

    .product-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2B2623;
        margin-bottom: 8px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price {
        font-size: 1.15rem;
        font-weight: 700;
        color: #8b6040;
        margin-bottom: 20px;
    }

    .btn-add-cart {
        background: #2B2623;
        color: #ffffff;
        padding: 12px 15px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        margin-top: auto;
        font-weight: 600;
        font-size: 0.95rem;
        transition: background 0.3s ease, transform 0.2s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .btn-add-cart:hover {
            background: #000000;
            transform: scale(1.03);
        }

    .combo-section {
        max-width: 1180px;
        margin: 70px auto;
        padding: 0 24px;
    }

    .combo-title {
        text-align: center;
        margin-bottom: 35px;
    }

        .combo-title span {
            color: #b08a63;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 13px;
        }

        .combo-title h2 {
            color: #2f241c;
            font-weight: 800;
            margin: 10px 0;
        }

        .combo-title p {
            color: #7f7368;
            margin: 0;
        }

    .combo-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 26px;
    }

    .combo-card {
        position: relative;
        background: #fffdfa;
        border: 1px solid #eadfd2;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 35px rgba(92, 65, 42, 0.08);
    }

    .combo-badge {
        position: absolute;
        top: 18px;
        right: 18px;
        background: #b08a63;
        color: #fff;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .combo-card h3 {
        color: #2f241c;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 20px;
        padding-right: 90px;
    }

    .combo-products {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 14px;
    }

    .combo-product {
        background: #faf7f2;
        border: 1px solid #eadfd2;
        border-radius: 16px;
        padding: 14px;
        text-align: center;
    }

        .combo-product img {
            width: 100%;
            height: 130px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 10px;
        }

        .combo-product strong {
            display: block;
            color: #2f241c;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .combo-product span {
            color: #7f7368;
            font-size: 13px;
        }

    .combo-plus {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #2f241c;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .combo-price {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 22px 0 18px;
    }

        .combo-price del {
            color: #9b9288;
        }

        .combo-price strong {
            color: #4f8a56;
            font-size: 20px;
            font-weight: 800;
        }

    .btn-add-combo {
        width: 100%;
        border: none;
        background: #2f241c;
        color: #fff;
        border-radius: 12px;
        padding: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.25s;
    }

        .btn-add-combo:hover {
            background: #7b5738;
        }

    @@media(max-width: 768px) {
        .combo-grid {
            grid-template-columns: 1fr;
        }

        .combo-products {
            grid-template-columns: 1fr;
        }

        .combo-plus {
            margin: 0 auto;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        function loadCartCount() {
            $.get('/Cart/GetCartCount', function (res) {
                if (res.count > 0) {
                    $('#cart-badge').text(res.count).fadeIn();
                } else {
                    $('#cart-badge').text(0).fadeOut();
                }
            });
        }

        loadCartCount();

        $('.btn-add-cart').click(function (e) {
            e.preventDefault();

            let btn = $(this);
            let originalHtml = btn.html();

            let productData = {
                productId: btn.data('id'),
                quantity: 1
            };

            btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Đang thêm...')
                .prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: productData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res.success) {
                        $('#cart-badge').text(res.totalItems).fadeIn();

                        btn.html('<i class="fa-solid fa-check"></i> Đã thêm')
                            .css('background', '#8b6040');

                        setTimeout(function () {
                            btn.html(originalHtml)
                                .css('background', '#2B2623')
                                .prop('disabled', false);
                        }, 1600);
                    } else {
                        alert(res.message || "Không thể thêm sản phẩm vào giỏ hàng.");
                        btn.html(originalHtml).prop('disabled', false);
                    }
                },
                error: function () {
                    alert("Có lỗi xảy ra, không thể thêm vào giỏ hàng.");
                    btn.html(originalHtml).prop('disabled', false);
                }
            });
        });

        $('.btn-add-combo').click(function (e) {
            e.preventDefault();

            let btn = $(this);
            let originalText = btn.text();

            let product1Id = btn.data('product1');
            let product2Id = btn.data('product2');

            btn.text('Đang thêm combo...').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddComboToCart", "Cart")',
                type: 'POST',
                data: {
                    product1Id: product1Id,
                    product2Id: product2Id
                },
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res.success) {
                        $('#cart-badge').text(res.totalItems).fadeIn();

                        btn.text('Đã thêm combo').css('background', '#8b6040');

                        setTimeout(function () {
                            btn.text(originalText)
                                .css('background', '#2f241c')
                                .prop('disabled', false);
                        }, 1600);
                    } else {
                        alert(res.message || "Không thể thêm combo vào giỏ hàng.");
                        btn.text(originalText).prop('disabled', false);
                    }
                },
                error: function () {
                    alert("Không kết nối được server.");
                    btn.text(originalText).prop('disabled', false);
                }
            });
        });

    });
</script>