@using System.Linq
@model IEnumerable<DoAnCK.Models.SANPHAM>

@{
    ViewBag.Title = "Kết quả tìm kiếm AI";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string tuKhoa = ViewBag.TuKhoa != null ? ViewBag.TuKhoa.ToString() : "";
}

<style>
    .ai-search-page {
        background: #f8f4ed;
        padding: 60px 7% 90px;
        color: #2b241f;
        min-height: 620px;
    }

    .ai-banner {
        max-width: 1180px;
        margin: 0 auto 38px;
        background: #fffdf8;
        border: 1px solid #eadfd2;
        border-radius: 24px;
        padding: 42px 30px;
        box-shadow: 0 18px 48px rgba(111, 78, 55, 0.07);
    }

    .ai-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f8f2ea;
        color: #8b6040;
        border: 1px solid #eadfd2;
        padding: 9px 16px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .ai-banner h2 {
        font-size: 36px;
        font-weight: 800;
        color: #2b2623;
        margin-bottom: 12px;
    }

    .ai-banner p {
        color: #6f6258;
        font-size: 16px;
        margin: 0;
    }

    .ai-banner strong {
        color: #8b6040;
    }

    .ai-search-box {
        max-width: 680px;
        margin: 24px auto 0;
        display: flex;
        gap: 12px;
        background: #ffffff;
        border: 1px solid #eadfd2;
        border-radius: 16px;
        padding: 8px;
    }

        .ai-search-box input {
            flex: 1;
            border: none;
            outline: none;
            padding: 0 14px;
            font-size: 15px;
            color: #2b241f;
        }

        .ai-search-box button {
            height: 46px;
            padding: 0 22px;
            border: none;
            border-radius: 12px;
            background: #2b2623;
            color: #fff;
            font-weight: 700;
            transition: 0.25s;
        }

            .ai-search-box button:hover {
                background: #000;
            }

    .alert-search {
        max-width: 1180px;
        margin: 0 auto 24px;
        border-radius: 14px;
    }

    .product-grid {
        max-width: 1180px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 26px;
    }

    .product-card {
        background: #fffdf8;
        border: 1px solid #eadfd2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(111, 78, 55, 0.06);
        transition: 0.25s;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 45px rgba(111, 78, 55, 0.12);
        }

    .product-image {
        width: 100%;
        height: 240px;
        background: #f4eee6;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: 0.4s;
        }

    .product-card:hover .product-image img {
        transform: scale(1.06);
    }

    .product-info {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
        text-align: center;
    }

        .product-info h5 {
            font-size: 16px;
            font-weight: 800;
            color: #2b2623;
            line-height: 1.4;
            min-height: 46px;
            margin-bottom: 10px;
        }

    .price {
        color: #8b6040;
        font-weight: 800;
        font-size: 18px;
        margin-bottom: 18px;
    }

    .btn-view {
        margin-top: auto;
        height: 44px;
        border-radius: 12px;
        background: #2b2623;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-decoration: none;
        transition: 0.25s;
    }

        .btn-view:hover {
            background: #000;
            color: #fff;
        }

    .empty-box {
        max-width: 720px;
        margin: 0 auto;
        background: #fffdf8;
        border: 1px solid #eadfd2;
        border-radius: 22px;
        padding: 46px 30px;
        text-align: center;
        box-shadow: 0 14px 40px rgba(111, 78, 55, 0.06);
    }

        .empty-box i {
            font-size: 54px;
            color: #b08a63;
            margin-bottom: 18px;
        }

        .empty-box h4 {
            font-weight: 800;
            color: #2b2623;
            margin-bottom: 12px;
        }

        .empty-box p {
            color: #6f6258;
            line-height: 1.7;
        }

    .btn-home {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 24px;
        background: #2b2623;
        color: #fff;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
    }

        .btn-home:hover {
            background: #000;
            color: #fff;
        }

    @@media (max-width: 992px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .ai-search-page {
            padding: 40px 18px 70px;
        }

        .product-grid {
            grid-template-columns: 1fr;
        }

        .ai-search-box {
            flex-direction: column;
        }

            .ai-search-box input,
            .ai-search-box button {
                width: 100%;
            }
    }
</style>

<div class="ai-search-page">

    <div class="ai-banner text-center">

        <span class="ai-badge">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            AI Furniture Search
        </span>

        <h2>Kết quả tìm kiếm</h2>

        <p>
            AI đã phân tích mô tả và tìm thấy những sản phẩm phù hợp với
            <strong>"@tuKhoa"</strong>
        </p>

        <form action="@Url.Action("Search", "Home")" method="get" class="ai-search-box">
            <input type="text"
                   name="keyword"
                   value="@tuKhoa"
                   placeholder="Nhập mô tả sản phẩm, ví dụ: ghế sofa màu kem..." />

            <button type="submit">
                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Tìm kiếm
            </button>
        </form>

    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning text-center alert-search">
            @ViewBag.Message
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="product-grid">

            @foreach (var item in Model)
            {
                var hinhAnh = string.IsNullOrEmpty(item.HinhAnh)
                    ? "~/Content/images/no-image.jpg"
                    : item.HinhAnh;

                <div class="product-card">

                    <div class="product-image">
                        <img src="@Url.Content(hinhAnh)" alt="@item.TenSP" />
                    </div>

                    <div class="product-info">

                        <h5>@item.TenSP</h5>

                        <div class="price">
                            @item.GiaHienTai.ToString("N0") đ
                        </div>

                        <a href="@Url.RouteUrl("ProductDetail", new { slug = item.Slug })"
                           class="btn-view">
                            Xem chi tiết
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-box">

            <i class="fa-regular fa-folder-open"></i>

            <h4>Không tìm thấy sản phẩm phù hợp</h4>

            <p>
                Hãy thử mô tả chi tiết hơn như:
                <br />
                "Ghế sofa màu kem cho phòng khách nhỏ"
            </p>

            <a href="@Url.Action("Index", "Home")"
               class="btn-home">
                Quay về trang chủ
            </a>

        </div>
    }

</div>